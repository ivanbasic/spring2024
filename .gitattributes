# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for these file types
*.md    text eol=lf
*.java  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.properties text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Binary files - no conversion
*.p12   binary
*.pem   binary
*.jar   binary
*.class binary
